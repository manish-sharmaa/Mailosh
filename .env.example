# Mailosh configuration.
#
# Copy to `.env` and fill in the two required values below. `.env` is
# gitignored and is read by three things: `docker compose` (for
# ${MAILOSH_...} interpolation and the `mailosh` service's `env_file`),
# pydantic-settings when the app or CLI runs on the host, and
# `scripts/stalwart-init.sh`.
#
# Every variable is prefixed `MAILOSH_`. Most map to a field on
# `mailosh.config.Settings`; the four in the "Production deployment"
# section below are read by `docker-compose.prod.yml` and the Caddyfile
# instead, and `Settings` ignores them (`extra="ignore"`) — the prefix is
# kept anyway so one file holds everything a deployment needs. Values shown
# commented out are that field's own default — uncomment only to change it.
# NEVER commit a real secret; nothing in this file is a working credential.
#
# On a production box: `chmod 600 .env`. Every secret in it is enough to
# read someone's mail.


# =====================================================================
# Required
# =====================================================================

# Stalwart's recovery-admin password. docker-compose.yml passes it as
# STALWART_RECOVERY_ADMIN=admin:<this>, and Mailosh's admin client uses it
# to mint and destroy each user's per-session Stalwart API key.
# Generate one with: openssl rand -hex 24
MAILOSH_STALWART_ADMIN_SECRET=changeme

# Root secret for the web app. Two keys are derived from it with HKDF-SHA256
# under separate purposes (mailosh/security/crypto.py): the Fernet key that
# encrypts each session's Stalwart API key, and the HMAC key that signs undo
# tokens. Session ids and CSRF tokens are independent random values, not
# derived from it. Must be >= 32 characters, and the app refuses to start
# while it still begins with "change-me" — so generate a real one before
# first boot:
#   openssl rand -hex 32
# Changing it later invalidates every existing session.
MAILOSH_SECRET_KEY=change-me-to-32-plus-random-characters


# =====================================================================
# Mail server
# =====================================================================

# Where Stalwart's HTTP (JMAP + admin) endpoint lives. The default suits a
# host-side CLI/pytest run; docker-compose.yml overrides it to
# http://stalwart:8080 for the container, which is the address that
# actually matters in the Docker stack.
# MAILOSH_STALWART_URL=http://localhost:8080

# Stalwart admin account name that MAILOSH_STALWART_ADMIN_SECRET belongs to.
# MAILOSH_STALWART_ADMIN_USER=admin


# =====================================================================
# Database
# =====================================================================

# Postgres holds application state only (users, sessions, label metadata,
# UI prefs, login attempts, audit log) — never mail content. The default
# suits host-side tooling (`make db-upgrade-host` points it at the
# published 55432); docker-compose.yml overrides it to
# postgresql+asyncpg://mailosh:mailosh@postgres:5432/mailosh inside the
# container. Use a real password for any deployment you expose.
# MAILOSH_DATABASE_URL=postgresql+asyncpg://mailosh:mailosh@localhost:5432/mailosh


# =====================================================================
# Live updates
# =====================================================================

# Live-update fan-out between workers. `memory` (default) keeps the
# update hub in process. `postgres` relays events over LISTEN/NOTIFY
# and requires MAILOSH_DATABASE_URL to be a Postgres URL.
# NOTE: this is transport only -- it does NOT make multi-worker safe.
MAILOSH_SSE_FANOUT=memory

# Read that NOTE as written. Mailosh runs ONE uvicorn worker, and that is a
# correctness constraint rather than a performance default: logout drops a
# session's pooled JMAP client in its own process only, so a second
# worker's open `GET /events` keeps streaming a revoked session's mail with
# no time bound. This setting moves live-update *events* between workers;
# it does not move that drop. docker-compose.prod.yml pins WEB_CONCURRENCY=1
# and carries the full reasoning; docs/specs/2026-09-05-production-deployment.md
# §12 is the short version.


# =====================================================================
# Sessions and cookies
# =====================================================================

# Sets the session cookie's Secure attribute, and picks the cookie name
# with it: `__Host-sid` when true, plain `sid` when false. Leave this
# `false` for local http://localhost development, and remove it (default
# true) for anything actually served over HTTPS.
MAILOSH_COOKIE_SECURE=false

# Trust X-Forwarded-For / X-Forwarded-Proto for the client's real IP.
# Enable ONLY behind a reverse proxy you control that overwrites those
# headers — otherwise a client can spoof its way past the login rate
# limiter, which keys on IP.
#
# Leave it alone here. `docker-compose.prod.yml` sets it true inline, where
# it is paired with the proxy half of the bargain: Caddy replaces an
# inbound X-Forwarded-For rather than appending to it (verified, and why
# the Caddy image is pinned), and the app publishes no port, so nothing but
# Caddy can set that header. Setting it true in this file, without both of
# those facts holding, is the foot-gun SECURITY.md names. See
# docs/specs/2026-09-05-production-deployment.md §5.
# MAILOSH_TRUST_PROXY=false

# Session lifetimes, in days. Idle expiry slides on each request;
# "Keep me signed in" swaps idle_days for remember_days. Absolute expiry
# is fixed at login and is never extended.
# MAILOSH_SESSION_IDLE_DAYS=14
# MAILOSH_SESSION_REMEMBER_DAYS=30
# MAILOSH_SESSION_ABSOLUTE_DAYS=90


# =====================================================================
# Production deployment
# =====================================================================
#
# Needed only by `docker-compose.prod.yml`, i.e. by
#
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#
# Leave the whole block out for local development; `make dev` never reads
# it. The reasoning behind every choice here is
# docs/specs/2026-09-05-production-deployment.md.
#
# All four are `${VAR:?...}` in the compose file, so a missing one fails
# `docker compose config` with an explanatory message instead of starting a
# stack with an empty password or an empty hostname.

# The hostname the webmail is served on — Caddy's site address, and the
# name it asks a CA to certify. It must already resolve, publicly, to this
# box, and ports 80 and 443 must reach it, BEFORE the first `up`: the first
# thing Caddy does is answer an ACME HTTP-01 challenge on port 80.
# No scheme, no path, no port. Just the name — e.g. mail.example.com.
#
# Left empty on purpose: a plausible-looking placeholder would pass the
# compose file's `:?` check and send Caddy off to get a certificate for
# somebody else's domain.
MAILOSH_SITE_ADDRESS=

# Where the certificate authority sends "your certificate expires in N
# days" when renewal has been failing. Use an inbox that is NOT on this
# server — if the mail server is what broke, you will not read it.
MAILOSH_ACME_EMAIL=

# The application database password. One variable, not two: the compose
# file feeds it to BOTH the `postgres` service's POSTGRES_PASSWORD and the
# app's MAILOSH_DATABASE_URL, because two values that must agree is a
# foot-gun and one is not.
#
# Generate with:  openssl rand -hex 24
# Hex on purpose — the value goes inside a URL, and a `@`, `:` or `/` in a
# password silently breaks the DSN.
#
# Read only once, at initdb, on the first boot with an empty `pg-data`
# volume. Changing it later changes the DSN the app dials and nothing about
# the database, so the app just stops authenticating; rotate with
# `ALTER USER mailosh WITH PASSWORD ...` first, then edit this. That also
# catches anyone converting a dev volume (initialised `mailosh:mailosh`)
# into a production one.
MAILOSH_PG_PASSWORD=

# Not a new variable — MAILOSH_STALWART_ADMIN_SECRET at the top of this
# file is the same one, and in production it stops being a convenience.
# The prod compose file passes it with `:?` instead of the dev default of
# `changeme`, because it is the credential that can mint a Stalwart API key
# for any mailbox on the server. It is also why production publishes
# Stalwart's HTTP port nowhere at all.

# Three more settings matter in production and are NOT listed here, on
# purpose: MAILOSH_COOKIE_SECURE, MAILOSH_TRUST_PROXY and uvicorn's
# FORWARDED_ALLOW_IPS are set inline by docker-compose.prod.yml, where
# `environment:` beats `env_file:` for the same key. That is deliberate —
# a production run cannot be talked into a non-Secure session cookie by a
# `.env` that still carries this file's localhost `MAILOSH_COOKIE_SECURE=false`.


# =====================================================================
# Development-stack account (optional)
# =====================================================================

# These are NOT used by the web app. Mailosh authenticates every user
# against Stalwart with their own credentials and holds a per-user session
# (mailosh/web/auth.py) — there is no shared service account.
#
# They name the demo mailbox that `scripts/stalwart-init.sh` creates on the
# local dev stack, and they are read by that script, by `mailosh
# import-mbox`, by `scripts/measure.py`, and by the integration tests
# (which skip when they are unset). Set them if you want the dev stack to
# come up with an account you can log in as; leave them out entirely on a
# real deployment and create accounts in Stalwart instead.
MAILOSH_DEMO_USER=demo@mailosh.test
MAILOSH_DEMO_PASSWORD=changeme

# SMTP port used only by scripts/measure.py when it injects a test message
# to time the delivery-to-SSE path. Matches docker-compose.yml's published
# 2525 -> Stalwart's 25.
# MAILOSH_SMTP_PORT=2525


# =====================================================================
# Not set here
# =====================================================================
#
# MAILOSH_RELOAD=1 turns on uvicorn's reloader in docker/entrypoint.sh.
# docker-compose.dev.yml sets it (that is what `make dev` runs); setting it
# in .env would have no effect without that file's bind mount.
